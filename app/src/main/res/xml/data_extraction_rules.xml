<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and newer; see
   backup_rules.xml for why these files are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nikomusic_auth.xml" />
        <exclude domain="sharedpref" path="nikomusic_auth_plain.xml" />
        <exclude domain="sharedpref" path="nikomusic_sources.xml" />
        <exclude domain="sharedpref" path="nikomusic_sources_plain.xml" />
        <!-- Tester code: a credential for this phone's owner (see AddonAuth). -->
        <exclude domain="sharedpref" path="nikomusic_tester.xml" />
        <!-- Playback queues are local session state; do not resurrect them after reinstall. -->
        <exclude domain="sharedpref" path="nikomusic_last_played.xml" />
        <exclude domain="sharedpref" path="nikomusic_bounded_context.xml" />
        <exclude domain="sharedpref" path="nikomusic_party_queue_stash.xml" />
        <!-- Drive backup: the account grant belongs to this phone (see DriveBackup). -->
        <exclude domain="sharedpref" path="nikomusic_drive_backup.xml" />
        <!-- Other devices' listening and what this one last uploaded: Drive sync's, and re-fetched from Drive. -->
        <exclude domain="file" path="listening-peers/" />
        <exclude domain="file" path="listening-synced/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nikomusic_auth.xml" />
        <exclude domain="sharedpref" path="nikomusic_auth_plain.xml" />
        <exclude domain="sharedpref" path="nikomusic_sources.xml" />
        <exclude domain="sharedpref" path="nikomusic_sources_plain.xml" />
        <!-- Tester code: a credential for this phone's owner (see AddonAuth). -->
        <exclude domain="sharedpref" path="nikomusic_tester.xml" />
        <!-- Playback queues are local session state; do not resurrect them after reinstall. -->
        <exclude domain="sharedpref" path="nikomusic_last_played.xml" />
        <exclude domain="sharedpref" path="nikomusic_bounded_context.xml" />
        <exclude domain="sharedpref" path="nikomusic_party_queue_stash.xml" />
        <!-- Drive backup: the account grant belongs to this phone (see DriveBackup). -->
        <exclude domain="sharedpref" path="nikomusic_drive_backup.xml" />
        <!-- Other devices' listening and what this one last uploaded: Drive sync's, and re-fetched from Drive. -->
        <exclude domain="file" path="listening-peers/" />
        <exclude domain="file" path="listening-synced/" />
    </device-transfer>
</data-extraction-rules>
