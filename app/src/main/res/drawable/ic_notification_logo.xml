<!--
  Status-bar / notification variant of the NikoMusic mark (assets/LogoTransparent.svg).

  Notification small icons are drawn as a silhouette: the system throws away
  every colour and keeps only the alpha channel, so the fill has to be opaque
  white. The source art is 300x500, scaled to fit cleanly centred inside the
  22x22 content box Android expects inside a 24x24 canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <group
      android:scaleX="0.040000"
      android:scaleY="0.040000"
      android:translateX="6.0000"
      android:translateY="2.0000">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M111.41,29.65L270.44,0.91L166.77,196.88L299.50,172.94L49.06,499.09L130.53,281.78L0.50,305.48Z"/>
  </group>
</vector>
